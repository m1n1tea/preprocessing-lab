# Remote OpenAI-compatible text generation (required for indexing).
GENERATION_API_BASE_URL=https://api.qubax.ai/v1
GENERATION_API_KEY=
GENERATION_MODEL=gpt-5.6-luna
# Local OpenAI-compatible vLLM embeddings endpoint. Most local servers accept EMPTY.
EMBEDDING_API_KEY=
EMBEDDING_MODEL=qwen3-embedding-4b
